# Required: independently provision a random JWT_SECRET of at least 32 characters.
# Example format only: <at-least-64-random-hex-characters>; never use this placeholder.
JWT_SECRET=
NEIS_API_KEY=
NEIS_OFFICE_CODE=
NEIS_SCHOOL_CODE=
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (로컬 Docker: docker compose up -d 후)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=classpage
DB_PASSWORD=
DB_DATABASE=classpage
DB_SYNC=false

# 호스팅(Neon / Render 등)에서 한 줄 URL 쓸 때 — 있으면 위 DB_* 는 무시됨
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# DB_SSL=true

# npm run seed:demo 시 데모 계정 비밀번호(선택, 기본 ClassPage2026!)
# Optional seed commands require explicit, deployment-specific passwords (12+ characters).

# DEMO_SEED_PASSWORD=
# CLASS_USERS_SEED_PASSWORD=
# DB_PASSWORD is required for local Docker too; use the same .env value for API and DB.
